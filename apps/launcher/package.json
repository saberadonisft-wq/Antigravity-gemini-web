{
  "name": "@antigravity-gemini-web/launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -b && vite build && node scripts/build-preload.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js",
    "dev": "vite",
    "start": "node scripts/start.mjs",
    "smoke:desktop": "node scripts/native-accounts-smoke.mjs",
    "smoke:cache": "node scripts/cache-smoke.mjs",
    "smoke:native-accounts": "node scripts/native-accounts-smoke.mjs",
    "build:test": "npm run build"
  },
  "dependencies": {
    "@antigravity-gemini-web/contracts": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "esbuild": "0.28.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
